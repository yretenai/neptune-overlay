DESCRIPTION="Manage the godot symlink"
MAINTAINER="ada@chronovore.dev"
VERSION="0"

inherit path-manipulation

BIN_DIR="${EROOT%/}/usr/bin"

# @FUNCTION: sort_targets
# @USAGE: <target identifier>...
# @DESCRIPTION:
# Lexicographically sorts an array of godot target identifiers.
sort_targets() {
	# stolen from luajit, amended to support 9999, alpha, rc
	local vsort="sort --version-sort"
	${vsort} </dev/null &>/dev/null || vsort=sort

	local prefix="^\(godot-\)\?"
	local digit="\([[:digit:].]\+\)"
	local suffix="[-_]"

	printf "%s\n" "$@" |
	sed -e "s/${prefix}9999/9999 0 &/" \
		-e "s/${prefix}${digit}${suffix}alpha/\2 1 &/" \
		-e "s/${prefix}${digit}${suffix}beta/\2 2 &/" \
		-e "s/${prefix}${digit}${suffix}rc/\2 3 &/" \
		-e "t;s/${prefix}${digit}/\2 4 &/" \
		| LC_ALL=C ${vsort} | sed 's/.* //'
}

# @FUNCTION: list_targets
# @DESCRIPTION:
# Returns a lexicographically-sorted list of godot targets found in `BIN_DIR`.
list_targets() {
	local identifiers
	mapfile -t identifiers < <(find "${BIN_DIR}" -maxdepth 1 -type f \
		-iname 'godot-*' -exec basename '{}' ';')
	sort_targets "${identifiers[@]}"
}

# @FUNCTION: list_targets
# @DESCRIPTION:
# Removes the current godot symlink target
remove_symlinks() {
	[[ -L "${BIN_DIR}/godot" ]] && rm "${BIN_DIR}/godot"
}

# @FUNCTION: set_symlinks
# @USAGE: <target identifier>
# @DESCRIPTION:
# Sets the current godot symlink target
set_symlinks() {
	local target=$1

	if is_number "${target}"; then
		local targets=( $(list_targets) )
		target=${targets[target-1]}
	fi

	if [[ -z ${target} ]]; then
		die -q "Target \"$1\" doesn't appear to be valid!"
	elif [[ -f "${BIN_DIR}/${target}" ]]; then
		ln -s "${target}" "${BIN_DIR}/godot"
	else
		die -q "Target \"$1\" doesn't appear to be valid!"
	fi
}

## list action

describe_list() {
	echo "List available godot symlink targets"
}

do_list() {
	local i targets=( $(list_targets) )

	write_list_start "Available godot symlink targets:"
		local SV=$(readlink "${BIN_DIR}/godot")
	for (( i = 0; i < ${#targets[@]}; i++ )); do
		[[ ${targets[i]} = \
			$(basename "${SV}") ]] \
			&& targets[i]=$(highlight_marker "${targets[i]}")
	done
	write_numbered_list -m "(none found)" "${targets[@]}"
}

## show action

describe_show() {
	echo "Show the current godot symlink"
}

do_show() {
	write_list_start "Current godot symlink:"
	if [[ -L ${BIN_DIR}/godot ]]; then
		local SV=$(readlink "${BIN_DIR}/godot")
		write_kv_list_entry "${SV%/}"
	else
		write_kv_list_entry "(unset)"
	fi
}

## set action

describe_set() {
	echo "Set a new godot symlink target"
}

describe_set_parameters() {
	echo "<target>"
}

describe_set_options() {
	echo "target : Target name or number (from 'list' action)"
}

do_set() {
	[[ -z $1 ]] && die -q "You didn't tell me what to set the symlink to"
	[[ $# -gt 1 ]] && die -q "Too many parameters"

	if [[ -L "${BIN_DIR}/godot" ]]; then
		# existing symlink
		remove_symlinks || die -q "Couldn't remove existing symlink"
		set_symlinks "$1" || die -q "Couldn't set a new symlink"
	elif [[ -e "${BIN_DIR}/godot" ]]; then
		# we have something strange
		die -q "${BIN_DIR}/godot exists but is not a symlink"
	else
		set_symlinks "$1" || die -q "Couldn't set a new symlink"
	fi
}

## unset action

describe_unset() {
	echo "Removes the godot symlink entirely"
}

do_unset() {
	remove_symlinks
}
